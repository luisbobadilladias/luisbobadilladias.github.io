---
import { getCollection } from 'astro:content';
import BlogPost from '../../views/BlogPost.astro';
import { splitId } from '../../lib/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => splitId(p.id).lang === 'es' && (import.meta.env.DEV || !p.data.draft));
  return posts.map((post) => ({ params: { slug: splitId(post.id).slug }, props: { post } }));
}
const { post } = Astro.props;
---

<BlogPost post={post} />
