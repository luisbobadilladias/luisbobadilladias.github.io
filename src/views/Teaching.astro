---
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/i18n';
import { routes, otherLang } from '../lib/i18n';
import { course, teaching as d, site } from '../lib/content';
import { longDate, time, capitalize } from '../lib/format';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = course[lang];
const s = site[lang];

// Masterclass date and link live in src/content/teaching.json.
const mc = d.masterclass;

const SITE = 'https://luisbobadilladias.github.io';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${t.masterclass.title}: ${d.courseName}`,
  description: t.description,
  startDate: mc.start,
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'VirtualLocation', url: d.signupUrl },
  isAccessibleForFree: true,
  inLanguage: 'es',
  organizer: { '@type': 'Person', name: s.name, url: `${SITE}/` },
};
---

<Base lang={lang} title={t.title} description={t.description} altPath={routes.teaching[otherLang(lang)]} route="teaching" jsonLd={[jsonLd]}>
  <header class="page-head wrap">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{d.courseName}</h1>
      <p class="lead">{t.lead}</p>
    </div>
  </header>

  <section class="section wrap" aria-labelledby="masterclass">
    <div class="band">
      <h2 id="masterclass">{t.masterclass.title}</h2>
      <p class="muted">{t.masterclass.text}</p>
      <dl class="facts">
        <div>
          <dt>{t.masterclass.when}</dt>
          <dd>
            <time datetime={mc.start}>{capitalize(longDate(lang, mc.start))}, {time(lang, mc.start)}</time>{' '}
            {t.masterclass.timeSuffix}
          </dd>
        </div>
        <div>
          <dt>{t.masterclass.where}</dt>
          <dd>{mc.platform}</dd>
        </div>
      </dl>
      <div class="actions">
        <a class="btn btn-primary" href={d.signupUrl} target="_blank" rel="noopener">{t.masterclass.cta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .band h2 {
    font-size: 1.6rem;
  }
</style>
