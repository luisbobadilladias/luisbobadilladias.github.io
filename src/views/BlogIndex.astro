---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import type { Lang } from '../lib/i18n';
import { routes, otherLang, tagPath, rssPath } from '../lib/i18n';
import { projectsPage, site, getPosts } from '../lib/content';

interface Props {
  lang: Lang;
  /** When set, only posts with this tag are listed. */
  tag?: string;
}
const { lang, tag } = Astro.props;
const t = projectsPage[lang];
const ui = site[lang].ui;
const all = await getPosts(lang);
const posts = tag ? all.filter((p) => p.data.tags.includes(tag)) : all;
const tags = [...new Set(all.flatMap((p) => p.data.tags))].sort();

const title = tag ? `${ui.postsTagged} “${tag}”` : t.blogTitle;
// Tags may not exist in the other language, so a tag page toggles to the other blog index.
const altPath = routes.blog[otherLang(lang)];
---

<Base lang={lang} title={title} description={t.blogDescription} altPath={altPath} route="projects" noindex={!!tag}>
  <header class="page-head wrap">
    <div>
      <h1>{title}</h1>
      <p class="lead">{t.blogLead}</p>
    </div>
  </header>

  <div class="section wrap">
    {
      tags.length > 0 && (
        <nav aria-label={ui.tags} class="tag-nav">
          <ul class="chips">
            {tag && (
              <li>
                <a class="chip" href={routes.blog[lang]}>
                  {ui.allPosts}
                </a>
              </li>
            )}
            {tags.map((x) => (
              <li>
                <a class="chip" href={tagPath(lang, x)} aria-current={x === tag ? 'page' : undefined}>
                  {x}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {posts.length ? <PostList lang={lang} posts={posts} /> : <p class="muted">{ui.noPosts}</p>}
    <p class="rss"><a href={rssPath(lang)}>{site[lang].footer.rss}</a></p>
  </div>
</Base>

<style>
  .tag-nav {
    margin-bottom: 2rem;
  }
  .tag-nav [aria-current='page'] {
    outline: 2px solid var(--accent);
  }
  .rss {
    margin-top: 2rem;
    font-size: 0.95rem;
  }
</style>
