---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/i18n';
import { routes, otherLang, postPath, tagPath, splitId } from '../lib/i18n';
import { site } from '../lib/content';
import { postDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { lang } = splitId(post.id) as { lang: Lang };
const ui = site[lang].ui;
const other = otherLang(lang);
const { Content } = await render(post);

// The language toggle goes to the translated post if one shares the translationKey.
let altPath: string = routes.blog[other];
if (post.data.translationKey) {
  const twin = (await getCollection('blog')).find(
    (p) => splitId(p.id).lang === other && p.data.translationKey === post.data.translationKey,
  );
  if (twin) altPath = postPath(other, splitId(twin.id).slug);
}

const SITE = 'https://luisbobadilladias.github.io';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    inLanguage: lang,
    author: { '@type': 'Person', '@id': `${SITE}/#person`, name: site[lang].name, url: `${SITE}${routes.home[lang]}` },
    mainEntityOfPage: new URL(Astro.url.pathname, SITE).href,
    keywords: post.data.tags.join(', '),
  },
];
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  altPath={altPath}
  route="projects"
  type="article"
  publishedTime={post.data.date}
  jsonLd={jsonLd}
>
  <article class="wrap post">
    <header class="post-head">
      <p class="back"><a href={routes.blog[lang]}>← {ui.backToBlog}</a></p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <p class="meta">
        {ui.publishedOn} <time datetime={post.data.date.toISOString().slice(0, 10)}>{postDate(lang, post.data.date)}</time>
        {
          post.data.updated && (
            <>
              {' · '}
              {ui.updatedOn} <time datetime={post.data.updated.toISOString().slice(0, 10)}>{postDate(lang, post.data.updated)}</time>
            </>
          )
        }
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="chips" aria-label={ui.tags}>
            {post.data.tags.map((tag) => (
              <li>
                <a class="chip" href={tagPath(lang, tag)}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    padding-block: clamp(2rem, 6vw, 4rem) 0;
  }
  .post-head {
    max-width: 42rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .back {
    font-size: 0.95rem;
  }
  .meta {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
