---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/i18n';
import { routes, otherLang } from '../lib/i18n';
import { career } from '../lib/content';
import { personSchema } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = career[lang];

// Badges live in src/assets/badges/<name>.png; reference them by name in career.json.
const badgeFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/badges/*.png', { eager: true });
const badge = (name?: string) => (name ? badgeFiles[`../assets/badges/${name}.png`]?.default : undefined);
---

<Base
  lang={lang}
  title={t.title}
  description={t.description}
  altPath={routes.career[otherLang(lang)]}
  route="career"
  jsonLd={[personSchema(lang)]}
>
  <header class="page-head wrap">
    <div>
      <h1>{t.title}</h1>
      <p class="lead">{t.lead}</p>
      <div class="actions">
        <a class="btn btn-primary" href={t.cv.file} download>{t.cv.label}</a>
      </div>
    </div>
  </header>

  <section class="section wrap" aria-labelledby="plub">
    <div class="plub">
      <div class="prose">
        <h2 id="plub">{t.plub.title}</h2>
        {t.plub.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="card">
        <h3>{t.plub.highlightsTitle}</h3>
        <ul class="ticks">
          {t.plub.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="timeline">
    <h2 id="timeline">{t.timelineTitle}</h2>
    <ol class="timeline clean-list">
      {
        t.timeline.map((item) => (
          <li>
            <p class="period">{item.period}</p>
            <h3>
              {item.role} · <span class="org">{item.org}</span>
            </h3>
            <p class="muted">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section wrap" aria-labelledby="education">
    <h2 id="education">{t.educationTitle}</h2>
    <ul class="grid grid-2 clean-list">
      {
        t.education.map((e) => (
          <li class="card">
            <p class="eyebrow">{e.year}</p>
            <h3>{e.degree}</h3>
            <p>{e.school}</p>
            {'text' in e && e.text && <p class="muted">{e.text}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap" aria-labelledby="certs">
    <h2 id="certs">{t.certsTitle}</h2>
    <ul class="certs clean-list">
      {
        t.certs.map((c) => {
          const img = badge('badge' in c ? c.badge : undefined);
          return (
            <li class="cert">
              {img ? (
                <Image src={img} alt="" width={56} height={56} class="badge" />
              ) : (
                <span class="badge badge-blank" aria-hidden="true">
                  ›
                </span>
              )}
              <div>
                <p class="cert-name">{c.name}</p>
                <p class="muted cert-meta">
                  {'issuer' in c && c.issuer ? `${c.issuer} · ` : ''}
                  {c.year}
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section wrap" aria-labelledby="skills">
    <h2 id="skills">{t.skillsTitle}</h2>
    <div class="skills">
      {
        t.skills.map((g) => (
          <div class="card">
            <h3>{g.group}</h3>
            <ul class="chips">
              {g.items.map((i) => (
                <li class="chip">{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .plub {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 56rem) {
    .plub {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }
  .timeline {
    border-left: 2px solid var(--border);
    margin-left: 0.4rem;
  }
  .timeline li {
    position: relative;
    padding: 0 0 2rem 1.5rem;
  }
  .timeline li:last-child {
    padding-bottom: 0;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -0.5rem;
    top: 0.3rem;
    width: 0.85rem;
    height: 0.85rem;
    background: var(--bg);
    border: 2px solid var(--accent);
    border-radius: 2px;
  }
  .timeline li:first-child::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  .timeline h3 {
    margin-bottom: 0.3rem;
  }
  .timeline p {
    margin-bottom: 0;
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem !important;
  }
  .org {
    color: var(--accent);
  }
  .certs {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .certs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .cert {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .cert p {
    margin: 0;
  }
  .cert-name {
    font-weight: 700;
    line-height: 1.3;
  }
  .cert-meta {
    font-size: 0.9rem;
  }
  :global(.badge) {
    flex: none;
    width: 56px;
    height: 56px;
    object-fit: contain;
  }
  .badge-blank {
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--accent);
  }
  .skills {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .skills {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .skills {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
