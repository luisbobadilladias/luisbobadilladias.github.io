---
import '@fontsource/space-grotesk/700.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang, RouteKey } from '../lib/i18n';
import { otherLang, rssPath } from '../lib/i18n';
import { site } from '../lib/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this same page in the other language. */
  altPath: string;
  route?: RouteKey;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: Date;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  altPath,
  route,
  type = 'website',
  image = `/og/og-${lang}.png`,
  imageAlt,
  publishedTime,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const s = site[lang];
const other = otherLang(lang);
const fullTitle = title.includes(s.name) ? title : `${title} · ${s.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const altUrl = new URL(altPath, Astro.site).href;
const esUrl = lang === 'es' ? canonical : altUrl;
const enUrl = lang === 'en' ? canonical : altUrl;
const imageUrl = new URL(image, Astro.site).href;
const ogLocale = { es: 'es_PY', en: 'en_US' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={s.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${s.name} · ${s.nav.blog}`} href={rssPath(lang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={s.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? `${s.name}, ${s.role}`} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C0C0C" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skipLink}</a>
    <Header lang={lang} route={route} altPath={altPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Re-check date-gated blocks (course CTAs) against the visitor's clock.
      const now = Date.now();
      document.querySelectorAll<HTMLElement>('[data-from], [data-until]').forEach((el) => {
        const from = el.dataset.from ? Date.parse(el.dataset.from) : -Infinity;
        const until = el.dataset.until ? Date.parse(el.dataset.until) : Infinity;
        el.hidden = !(now >= from && now < until);
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    background: var(--cta-bg);
    color: var(--cta-text);
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-weight: 700;
  }
  .skip-link:focus {
    top: 1rem;
  }
  main:focus {
    outline: none;
  }
</style>
