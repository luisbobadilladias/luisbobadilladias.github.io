---
import type { Lang } from '../lib/i18n';
import { site, contact, whatsappUrl, mailtoUrl } from '../lib/content';
import { brandIcons } from '../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = site[lang];
const f = s.footer;

// Email shows the address so it can be copied; the rest show the network name.
const links = [
  { label: f.emailLabel, href: mailtoUrl(), text: contact.email, icon: 'mail' },
  { label: f.whatsappLabel, href: whatsappUrl(f.whatsappMessage), text: 'WhatsApp', icon: 'whatsapp' },
  { label: 'LinkedIn', href: contact.linkedin, text: 'LinkedIn', icon: 'linkedin' },
  { label: 'GitHub', href: contact.github, text: 'GitHub', icon: 'github' },
  { label: 'Substack', href: contact.substack, text: 'Substack', icon: 'substack' },
].filter((l) => l.href) as { label: string; href: string; text: string; icon: 'mail' | keyof typeof brandIcons }[];
---

<footer class="site-footer" id="contacto">
  <div class="wrap">
    <div class="footer-head">
      <div>
        <h2>{f.title}</h2>
        <p class="footer-text">{f.text}</p>
      </div>
    </div>
    <ul class="contact-list clean-list">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-label={l.text === l.label ? undefined : `${l.label}: ${l.text}`}
              {...(l.href.startsWith('http') ? { rel: 'me noopener', target: '_blank' } : {})}
            >
              {l.icon === 'mail' ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path d={brandIcons[l.icon]} />
                </svg>
              )}
              <span>{l.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="footer-meta">
      © {new Date().getFullYear()} {s.name}. {f.rights}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--band-bg);
    color: var(--band-text);
    padding-block: clamp(2.5rem, 7vw, 4rem) 2rem;
    margin-top: clamp(3rem, 8vw, 5rem);
  }
  .site-footer a {
    color: var(--band-text);
  }
  .footer-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .footer-text {
    color: var(--band-muted);
    max-width: 34rem;
  }
  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .contact-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--band-border);
    border-radius: 999px;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: border-color 0.15s, color 0.15s;
  }
  .contact-list a:hover,
  .contact-list a:focus-visible {
    border-color: var(--band-accent);
  }
  .contact-list svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--band-accent);
  }
  .footer-meta {
    margin: 2.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--band-border);
    font-size: 0.9rem;
    color: var(--band-muted);
  }
</style>
