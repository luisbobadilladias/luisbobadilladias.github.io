---
import type { Lang } from '../lib/i18n';
import { rssPath } from '../lib/i18n';
import { site, contact, whatsappUrl, mailtoUrl } from '../lib/content';
import Motif from './Motif.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = site[lang];
const f = s.footer;

const strip = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const links = [
  { label: f.emailLabel, href: mailtoUrl(), text: contact.email },
  { label: f.whatsappLabel, href: whatsappUrl(f.whatsappMessage), text: '+595 971 969 066' },
  { label: 'LinkedIn', href: contact.linkedin, text: strip(contact.linkedin) },
  { label: 'GitHub', href: contact.github, text: strip(contact.github) },
  { label: 'Instagram', href: contact.instagram, text: strip(contact.instagram) },
].filter((l) => l.href);
---

<footer class="site-footer" id="contacto">
  <div class="wrap">
    <div class="footer-head">
      <div>
        <h2>{f.title}</h2>
        <p class="footer-text">{f.text}</p>
      </div>
      <Motif class="footer-motif" />
    </div>
    <ul class="contact-list clean-list">
      {
        links.map((l) => (
          <li>
            <span class="contact-label">{l.label}</span>
            <a
              href={l.href}
              {...(l.href.startsWith('http') ? { rel: 'me noopener', target: '_blank' } : {})}
            >
              {l.text}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="footer-meta">
      © {new Date().getFullYear()} {s.name}. {f.rights} · <a href={rssPath(lang)}>{f.rss}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--band-bg);
    color: var(--band-text);
    padding-block: clamp(2.5rem, 7vw, 4rem) 2rem;
    margin-top: clamp(3rem, 8vw, 5rem);
  }
  .site-footer a {
    color: var(--band-text);
  }
  .footer-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .footer-text {
    color: var(--band-muted);
    max-width: 34rem;
  }
  .contact-list {
    display: grid;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 40rem) {
    .contact-list {
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    }
  }
  .contact-list li {
    display: grid;
    gap: 0.1rem;
  }
  .contact-list a {
    display: inline-block;
    padding-block: 0.2rem;
    overflow-wrap: anywhere;
  }
  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--band-accent);
  }
  .footer-meta {
    margin: 2.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--band-border);
    font-size: 0.9rem;
    color: var(--band-muted);
  }
  @media (max-width: 30rem) {
    :global(.footer-motif) {
      display: none;
    }
  }
</style>
