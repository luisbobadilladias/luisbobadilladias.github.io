---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../lib/i18n';
import { postPath, tagPath, splitId } from '../lib/i18n';
import { postDate } from '../lib/format';

interface Props {
  lang: Lang;
  posts: CollectionEntry<'blog'>[];
}
const { lang, posts } = Astro.props;
---

<ul class="post-list clean-list">
  {
    posts.map((p) => (
      <li class="post-item">
        <h3>
          <a href={postPath(lang, splitId(p.id).slug)}>{p.data.title}</a>
        </h3>
        <p class="muted">{p.data.description}</p>
        <p class="post-meta">
          <time datetime={p.data.date.toISOString().slice(0, 10)}>{postDate(lang, p.data.date)}</time>
          {p.data.tags.map((tag) => (
            <a class="chip" href={tagPath(lang, tag)}>
              {tag}
            </a>
          ))}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .post-item {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .post-item:first-child {
    padding-top: 0;
  }
  .post-item h3 {
    margin-bottom: 0.35rem;
  }
  .post-item h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .post-item h3 a:hover {
    text-decoration: underline;
  }
  .post-item p {
    margin-bottom: 0.5rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
