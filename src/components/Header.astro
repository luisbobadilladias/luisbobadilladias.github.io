---
import type { Lang, RouteKey } from '../lib/i18n';
import { navKeys, routes, otherLang } from '../lib/i18n';
import { site } from '../lib/content';

interface Props {
  lang: Lang;
  route?: RouteKey;
  altPath: string;
}
const { lang, route, altPath } = Astro.props;
const s = site[lang];
const other = otherLang(lang);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={routes.home[lang]} aria-current={route === 'home' ? 'page' : undefined}>
      Luis Bobadilla Dias
    </a>

    <nav class="nav" aria-label={s.navLabel}>
      <ul>
        {
          navKeys.map((k) => (
            <li>
              <a href={routes[k][lang]} aria-current={route === k ? 'page' : undefined}>
                {s.nav[k]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <div class="lang" role="group" aria-label={s.langToggle.label}>
        <span class="lang-current" aria-current="true">{lang.toUpperCase()}</span>
        <a href={altPath} hreflang={other} lang={other} aria-label={`${other.toUpperCase()}: ${s.langToggle.switchTo}`}>{other.toUpperCase()}</a>
      </div>
      <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" hidden>
        <span class="visually-hidden">{s.themeToggle}</span>
        <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </g>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (btn) {
    const root = document.documentElement;
    const current = () =>
      root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const sync = () => btn.setAttribute('aria-pressed', String(current() === 'dark'));
    btn.hidden = false;
    sync();
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    });
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'brand tools' 'nav nav';
    align-items: center;
    column-gap: 1rem;
    padding-block: 0.75rem 0;
  }
  .brand {
    grid-area: brand;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    padding-block: 0.5rem;
  }
  .nav {
    grid-area: nav;
    overflow-x: auto;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: block;
    white-space: nowrap;
    padding: 0.75rem 0.6rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 3px solid transparent;
  }
  .nav li:first-child a {
    padding-left: 0;
  }
  .nav a:hover {
    color: var(--text);
  }
  .nav a[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  .tools {
    grid-area: tools;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lang {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    overflow: hidden;
  }
  .lang > * {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.5rem;
    padding-inline: 0.5rem;
  }
  .lang-current {
    background: var(--chip-bg);
    color: var(--chip-text);
  }
  .lang a {
    color: var(--text);
    text-decoration: none;
  }
  .lang a:hover {
    text-decoration: underline;
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle .icon-sun {
    display: none;
  }
  .theme-toggle[aria-pressed='true'] .icon-sun {
    display: block;
  }
  .theme-toggle[aria-pressed='true'] .icon-moon {
    display: none;
  }

  @media (max-width: 25rem) {
    .nav ul {
      gap: 0;
      justify-content: space-between;
    }
    .nav a {
      padding-inline: 0.4rem;
      font-size: 0.95rem;
    }
    .nav li:last-child a {
      padding-right: 0;
    }
  }
  @media (min-width: 52rem) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav tools';
      padding-block: 0.5rem;
    }
    .nav {
      margin: 0;
      padding: 0;
      justify-self: end;
    }
    .nav a {
      padding: 1rem 0.75rem;
    }
    .nav li:first-child a {
      padding-left: 0.75rem;
    }
  }
</style>
